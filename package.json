{
  "name": "signaldesk-analytics-workflow-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev --filter=@signaldesk/console",
    "build": "turbo build --filter=@signaldesk/console",
    "test": "node --experimental-strip-types --test tests/*.test.ts && vitest run packages/",
    "typecheck": "tsc --noEmit && turbo typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "engines": { "node": ">=22.18" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
